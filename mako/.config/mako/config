sort=-time
layer=overlay
default-timeout=9000
ignore-timeout=0
font=JetBrains Mono Nerd Font 12
history=1
max-history=20

# Style
background-color=#000000aa
width=350
height=200
border-size=1
border-color=#88c0d0
border-radius=8
icons=1
outer-margin=18, 10, 10,18
margin=8, 0, 0,0
padding=16, 16, 16, 16
text-alignment=center
progress-color= over #6587b9
max-icon-size=64
icon-path=~/.local/share/icons/TokyoNight-SE
anchor=bottom-right

[urgency=low]
border-color=#40526c
progress-color=source #6587b9

[urgency=normal]
border-color=#6587b9
progress-color= over #6587b9

[urgency=high]
border-color=#bf616a
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
